<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bagwiz</name>
  <version>0.1.0</version>
  <description>bagwiz — a terminal wizard, swift as a spark, for the recorded worlds of ROS 2 rosbags.</description>
  <maintainer email="mineto.tsukada@tier4.jp">Mineto Tsukada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>bagwiz_bag</depend>
  <depend>bagwiz_base</depend>
  <depend>bagwiz_image</depend>
  <depend>bagwiz_io</depend>
  <depend>bagwiz_msg</depend>
  <depend>bagwiz_pointcloud</depend>
  <depend>bagwiz_slam</depend>
  <depend>bagwiz_tf</depend>
  <depend>bagwiz_tui</depend>
  <depend>bagwiz_video</depend>
  <depend>ffmpeg</depend>
  <depend>geographiclib</depend>
  <depend>geometry_msgs</depend>
  <depend>rcutils</depend>
  <depend>rmw</depend>
  <depend>rmw_implementation</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend condition="$ROS_DISTRO != 'humble' and $ROS_DISTRO != 'jazzy'">zstd_cmake_module</depend>
  <depend condition="$ROS_DISTRO == 'humble' or $ROS_DISTRO == 'jazzy'">zstd_vendor</depend>
  <!-- zstd provider split upstream: Humble and Jazzy ship zstd_vendor;
       newer (rolling) distros replaced it with zstd_cmake_module. Select by distro. -->

  <!-- Runtime-only: never find_package()'d and no headers are included. The
       rmw_serialize/rmw_deserialize calls route through rmw_implementation,
       which dlopens the RMW selected by RMW_IMPLEMENTATION at run time; the
       pixi environments pin that to rmw_cyclonedds_cpp. -->
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
