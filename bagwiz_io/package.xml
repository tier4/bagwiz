<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bagwiz_io</name>
  <version>0.1.0</version>
  <description>bagwiz bag IO: MCAP and SQLite3 rosbag readers/writers, metadata, and (de)compression.</description>
  <maintainer email="mineto.tsukada@tier4.jp">Mineto Tsukada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>bagwiz_base</depend>
  <depend>libsqlite3-dev</depend>
  <depend>mcap_vendor</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend condition="$ROS_DISTRO != 'humble' and $ROS_DISTRO != 'jazzy'">zstd_cmake_module</depend>
  <depend condition="$ROS_DISTRO == 'humble' or $ROS_DISTRO == 'jazzy'">zstd_vendor</depend>
  <!-- zstd provider split upstream: Humble and Jazzy ship zstd_vendor;
       newer (rolling) distros replaced it with zstd_cmake_module. Select by distro. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
