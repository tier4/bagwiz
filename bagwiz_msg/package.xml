<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bagwiz_msg</name>
  <version>0.1.0</version>
  <description>bagwiz message layer: CDR walking, schema parsing, introspection and schema-driven decoding, and YAML conversion.</description>
  <maintainer email="mineto.tsukada@tier4.jp">Mineto Tsukada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>bagwiz_base</depend>
  <depend>bagwiz_io</depend>
  <depend>geographiclib</depend>
  <depend>geometry_msgs</depend>
  <depend>rcutils</depend>
  <depend>rmw</depend>
  <depend>rmw_implementation</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- Runtime-only: never find_package()'d and no headers are included.
       message_deserializer.cpp / ros2_yaml_to_cdr.cpp call
       rmw_deserialize/rmw_serialize, which route through rmw_implementation
       to the RMW selected by RMW_IMPLEMENTATION at run time; the pixi
       environments pin that to rmw_cyclonedds_cpp. -->
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
