<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bagwiz</name>
  <version>0.1.0</version>
  <description>bagwiz — a terminal wizard, swift as a spark, for the recorded worlds of ROS 2 rosbags.</description>
  <maintainer email="mineto.tsukada@tier4.jp">Mineto Tsukada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>geographiclib</depend>
  <depend>geometry_msgs</depend>
  <depend>libsqlite3-dev</depend>
  <depend>mcap_vendor</depend>
  <depend>nav_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>rcutils</depend>
  <depend>rmw</depend>
  <depend>rmw_cyclonedds_cpp</depend>
  <depend>rmw_implementation</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend condition="$ROS_DISTRO != 'humble' and $ROS_DISTRO != 'jazzy'">zstd_cmake_module</depend>
  <depend condition="$ROS_DISTRO == 'humble' or $ROS_DISTRO == 'jazzy'">zstd_vendor</depend>
  <!-- zstd provider split upstream: Humble and Jazzy ship zstd_vendor;
       Lyrical and newer replaced it with zstd_cmake_module. Select by distro. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
